{
  "name": "example-sso-operator-local",
  "main": "src/operator.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRETS",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "ALLOWED_GOOGLE_DOMAIN",
      "OPERATOR_NONCE",
      "OPERATOR_ACTION"
    ]
  },
  "vars": {
    "AUTH_ISSUER": "https://auth.example.invalid"
  },
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "example-sso",
      "database_id": "00000000000000000000000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
